{
  "manuscript": "MANUSCRIPT.md",
  "chapters_dir": "chapters",
  "characters_dir": "characters",
  "corpus_profile": "data/prose_reference.json",
  "corpus_dirs": [],
  "analysis": {
    "comparison_unit": "unknown",
    "min_sentences_for_corpus": 40,
    "min_words_for_corpus": 500
  },
  "text_processing": {
    "strip_gutenberg": true,
    "strip_markdown_headings": true,
    "strip_transcript": true,
    "drop_marker_paragraphs": true,
    "normalize_quotes": false,
    "segmenter": "auto",
    "language": "en",
    "segmenter_clean": false,
    "transcript": null
  },
  "nlp": {
    "model": "en_core_web_sm",
    "disable": [
      "ner"
    ],
    "max_chars_per_chunk": 400000,
    "max_words": null
  },
  "regex": {
    "engine": "auto",
    "timeout_seconds": 2.0
  },
  "corpus_builder": {
    "output_dir": "corpus",
    "count": 40,
    "minimum_count": 30,
    "providers": [
      "gutenberg"
    ],
    "metadata_providers": [
      "openlibrary",
      "google_books"
    ],
    "work_types": [
      "fiction"
    ],
    "genres": [],
    "include_terms": [],
    "exclude_terms": [],
    "include_authors": [],
    "max_authors": null,
    "max_books_per_author": 2
  },
  "metrics": {
    "repeated_ngrams": {
      "enabled": true,
      "sizes": [
        3,
        4,
        5,
        6
      ],
      "min_count": 2,
      "max_reported": 40
    },
    "sentence_openings": {
      "enabled": true,
      "words": 3
    },
    "local_repetition": {
      "enabled": true,
      "windows": [
        50,
        100,
        250
      ]
    },
    "function_words": {
      "enabled": false
    },
    "mattr": {
      "enabled": true,
      "window": 100
    },
    "punctuation": {
      "enabled": true
    },
    "length_quantiles": {
      "enabled": true
    },
    "pov_pronouns": {
      "enabled": true,
      "block_words": 500
    },
    "dialogue_contractions": {
      "enabled": true
    },
    "dialogue_tags": {
      "enabled": true
    },
    "sentence_segmentation": {
      "enabled": false
    },
    "passive_voice": {
      "enabled": false
    },
    "clause_structure": {
      "enabled": false
    },
    "pos_distribution": {
      "enabled": false
    },
    "tense_consistency": {
      "enabled": false
    },
    "nominalizations": {
      "enabled": false
    },
    "character_voice": {
      "enabled": false
    },
    "distribution_shape": {
      "enabled": true,
      "bands": 5
    },
    "sentence_length_autocorrelation": {
      "enabled": false,
      "lags": [
        1,
        2,
        3
      ]
    },
    "sentence_length_deltas": {
      "enabled": false
    },
    "sentence_run_lengths": {
      "enabled": false,
      "short_max": 8,
      "long_min": 25
    },
    "sentence_length_entropy": {
      "enabled": false
    },
    "paragraph_rhythm": {
      "enabled": false
    },
    "single_sentence_paragraph_runs": {
      "enabled": false
    },
    "dependency_distance": {
      "enabled": false
    },
    "parse_depth": {
      "enabled": false
    },
    "finite_clauses": {
      "enabled": false
    },
    "clause_types": {
      "enabled": false
    },
    "coordination_ratio": {
      "enabled": false
    },
    "opening_patterns": {
      "enabled": false,
      "depth": 2,
      "max_reported": 25
    },
    "mtld": {
      "enabled": false,
      "threshold": 0.72
    },
    "hdd": {
      "enabled": false,
      "sample": 42
    },
    "word_rarity": {
      "enabled": false,
      "language": "en"
    },
    "repetition_distance": {
      "enabled": false,
      "min_length": 4
    },
    "lemma_repetition": {
      "enabled": false
    },
    "adjacent_sentence_similarity": {
      "enabled": false,
      "model": "all-MiniLM-L6-v2"
    },
    "local_similarity_window": {
      "enabled": false,
      "model": "all-MiniLM-L6-v2",
      "windows": [
        3,
        5
      ]
    },
    "paragraph_similarity": {
      "enabled": false,
      "model": "all-MiniLM-L6-v2"
    },
    "duplicate_sentence_clusters": {
      "enabled": false,
      "model": "all-MiniLM-L6-v2",
      "threshold": 0.85,
      "max_reported": 30
    },
    "dialogue_channels": {
      "enabled": false
    },
    "dialogue_turn_lengths": {
      "enabled": false
    },
    "speaker_style": {
      "enabled": false,
      "min_turns": 8
    },
    "dialogue_attribution": {
      "enabled": false
    },
    "dialogue_runs": {
      "enabled": false
    },
    "speaker_function_words": {
      "enabled": false,
      "min_turns": 8
    },
    "sentence_initial_connectives": {
      "enabled": false
    },
    "causal_connectives": {
      "enabled": false
    },
    "hedges_boosters": {
      "enabled": false
    },
    "rhetorical_constructions": {
      "enabled": false,
      "max_reported": 30,
      "min_count": 3
    },
    "narration_pov": {
      "enabled": false
    },
    "pov_block_confidence": {
      "enabled": false,
      "block_words": 1000
    },
    "entity_pronoun_ratio": {
      "enabled": false,
      "enable_ner": true
    },
    "punctuation_profile": {
      "enabled": false
    },
    "punctuation_entropy": {
      "enabled": false
    },
    "punctuation_patterns": {
      "enabled": false,
      "max_reported": 25
    },
    "chapter_zscores": {
      "enabled": false,
      "window_words": 2500
    },
    "rolling_drift": {
      "enabled": false,
      "window_words": 2500
    },
    "change_points": {
      "enabled": false,
      "window_words": 2500,
      "penalty": 3.0
    },
    "coherence_suite": {
      "enabled": false,
      "features": {
        "lexical": true,
        "semantic": true,
        "entity": true,
        "connectives": true,
        "order_permutation": true
      },
      "min_word_len": 3,
      "chain_gap": 3,
      "chain_min_length": 2,
      "semantic_model": "all-MiniLM-L6-v2",
      "semantic_low_tail_threshold": 0.15,
      "entity_lookback_sentences": 10,
      "entity_max_tracked": 150,
      "entity_graph_window_sentences": 3,
      "entity_min_mentions_for_graph": 2,
      "connective_max_reported": 25,
      "permutations": 50,
      "seed": 0,
      "order_min_sentences_per_paragraph": 4,
      "order_max_sentences_per_paragraph": 40,
      "order_max_paragraphs_sampled": 30,
      "order_max_paragraphs_for_doc": 60
    },
    "randomness_suite": {
      "enabled": false,
      "features": {
        "char_entropy": true,
        "compression": true,
        "complexity_measures": true,
        "language_model": true,
        "punctuation_sequence": true,
        "pos_dependency": false,
        "corruption_baselines": true,
        "lexical_gibberish": true
      },
      "language": "en",
      "char_ngram_orders": [2, 3, 4, 5, 6],
      "byte_ngram_order": 3,
      "word_ngram_orders": [1, 2, 3, 4],
      "punct_ngram_order": 3,
      "pos_ngram_order": 3,
      "dependency_ngram_order": 2,
      "lm_train_fraction": 0.7,
      "lm_smoothing_alpha": 0.5,
      "lm_max_chars": 150000,
      "lm_max_tokens": 60000,
      "entropy_token_cap": 100000,
      "renyi_orders": [0.5, 2.0],
      "tsallis_orders": [0.5, 2.0],
      "excess_entropy_max_order": 4,
      "mi_lags": [1, 2, 3],
      "mi_max_tokens": 20000,
      "complexity_quadratic_cap": 1500,
      "permutation_order": 3,
      "lz_max_chars": 20000,
      "compression_algorithms": ["zlib", "gzip", "bz2", "lzma", "zstd", "brotli", "lz4", "snappy", "ppmd"],
      "compression_level": 6,
      "compression_block_chars": 20000,
      "ncd_algorithm": "zlib",
      "corruption_seed": 1337,
      "corruption_permutations": 3,
      "corruption_sentence_fraction": 0.3,
      "corruption_char_order": 4,
      "corruption_word_order": 2,
      "corruption_max_chars": 20000,
      "consonant_cluster_min": 4
    },
    "absolutes": false,
    "banned_phrases": false,
    "check_edits": false,
    "dialogue_study": false,
    "number_report": false,
    "prose_check": false,
    "quotable": false,
    "quote_length": false,
    "register": false,
    "style_report": false,
    "tics": false,
    "verify_citations": false,
    "voice_separation": false,
    "logic_suite": {
      "enabled": false,
      "features": {
        "negation_and_quantifiers": true,
        "connective_relations": true,
        "propositions": true,
        "modal_argument_position": true
      },
      "window_sentences": 6,
      "max_pairs": 200,
      "max_comparisons": 50000,
      "max_evidence": 20,
      "proposition_cap": 20000,
      "connective_min_words": 4,
      "repeated_assertion_min_words": 5
    },
    "timeseries_suite": {
      "enabled": false,
      "sequences": ["sentence_words", "paragraph_words", "sentence_punctuation"],
      "feature_groups": ["dispersion", "acf", "trend", "turning_points", "runs"],
      "lags": [1, 2, 3],
      "pacf_max_lag": 5,
      "window_words": 2000,
      "rolling_window": 10,
      "change_point_penalty": 3.0,
      "page_hinkley_delta": 0.005,
      "page_hinkley_lambda": 3.0,
      "permutation_entropy_order": 3,
      "permutation_entropy_delay": 1,
      "dfa_min_box": 4,
      "piecewise_segments": 2,
      "detrend": false,
      "embedding_model": "all-MiniLM-L6-v2",
      "language": "en",
      "min_lengths": {},
      "max_findings": 200
    },
    "stylometry_suite": {
      "enabled": false,
      "features": {
        "character_ngrams": true,
        "byte_ngrams": true,
        "word_ngrams": true,
        "function_word_ngrams": true,
        "punctuation_shape": true,
        "word_shape": true,
        "affixes": true,
        "sentence_openings": true,
        "contractions_capitalization": true,
        "lexical_richness": true,
        "vocabulary_growth": true,
        "section_stability": true,
        "compression": true,
        "corpus_language_model": true,
        "corpus_reference": true,
        "pos_dependency": false
      },
      "char_ngram_orders": [2, 3, 4, 5, 6],
      "byte_ngram_orders": [2],
      "word_ngram_orders": [1, 2, 3],
      "pos_ngram_orders": [1, 2, 3, 4],
      "dependency_ngram_order": 2,
      "punctuation_ngram_order": 2,
      "affix_length": 3,
      "min_affix_word_length": 5,
      "max_reported": 25,
      "max_chars_for_ngrams": 500000,
      "section_window_words": 3000,
      "section_shift_threshold": 2.5,
      "k_neighbors": 5,
      "distance_metrics": ["cosine", "euclidean", "manhattan", "jensen_shannon"],
      "primary_distance": "cosine",
      "compression_algorithm": "zlib",
      "min_corpus_documents": 4,
      "min_documents_per_author": 2,
      "outlier_threshold": 3.5,
      "seed": 42
    }
  },
  "allow_external_metric_commands": false,
  "project_rules": {
    "banned_phrases": [],
    "em_dash": null,
    "quote_style": null,
    "hard_line_breaks": null,
    "chapter_length": null
  },
  "project_measures": {}
}
