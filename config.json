{
  "manuscript": "MANUSCRIPT.md",
  "chapters_dir": "chapters",
  "characters_dir": "characters",
  "corpus_profile": "prose_reference.json",
  "corpus_builder": {
    "output_dir": "corpus",
    "count": 40,
    "minimum_count": 30,
    "providers": ["gutenberg"],
    "metadata_providers": ["openlibrary", "google_books"],
    "work_types": ["fiction"],
    "genres": [],
    "include_terms": [],
    "exclude_terms": [],
    "include_authors": [],
    "max_authors": null,
    "max_books_per_author": 2
  },
  "text_processing": {},
  "metrics": {
    "repeated_ngrams": {"enabled": false},
    "sentence_openings": {"enabled": false},
    "local_repetition": {"enabled": false},
    "function_words": {"enabled": false},
    "mattr": {"enabled": false},
    "punctuation": {"enabled": false},
    "length_quantiles": {"enabled": false},
    "pov_pronouns": {"enabled": false},
    "dialogue_contractions": {"enabled": false},
    "dialogue_tags": {"enabled": false},
    "sentence_segmentation": {"enabled": false, "language": "en", "clean": false},
    "passive_voice": {"enabled": false},
    "clause_structure": {"enabled": false},
    "pos_distribution": {"enabled": false},
    "tense_consistency": {"enabled": false},
    "nominalizations": {"enabled": false},
    "character_voice": {"enabled": false},
    "absolutes": true,
    "banned_phrases": true,
    "check_edits": true,
    "dialogue_study": true,
    "number_report": true,
    "prose_check": true,
    "quotable": true,
    "quote_length": true,
    "register": true,
    "style_report": true,
    "tics": true,
    "verify_citations": true,
    "voice_separation": true
  },
  "nlp": {"model": "en_core_web_sm"},
  "allow_external_metric_commands": false,
  "project_rules": {
    "banned_phrases": [],
    "em_dash": null,
    "quote_style": null,
    "hard_line_breaks": null,
    "chapter_length": null
  }
}
